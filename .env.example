# Copia este archivo como .env (solo para pruebas locales con node server.js).
# En Vercel, estas variables se configuran en Settings > Environment Variables.
# NUNCA subas el archivo .env a GitHub.
OPENROUTER_API_KEY=pega_aqui_tu_key
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Modelos gratuitos de respaldo si el principal falla o está saturado (separados por coma)
OPENROUTER_FALLBACK_MODELS=openrouter/free,google/gemma-4-31b-it:free
